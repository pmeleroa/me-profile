---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const phases = [
  {
    title: 'Debate',
    ai: 'Pregunta, revisa el repositorio y el contenido que ya existe, y propone opciones con una recomendación razonada.',
    me: 'Elijo, corrijo o descarto. Decido qué entra y qué se queda fuera.',
  },
  {
    title: 'Acuerdo',
    ai: 'Redacta lo debatido: la propuesta, el diseño, las especificaciones que el resultado debe cumplir y las tareas con su forma de verificarlas.',
    me: 'Reviso el alcance antes de que se construya nada.',
  },
  {
    title: 'Construcción',
    ai: 'Escribe el código o el texto y lo comprueba: build, validación de las especificaciones, accesibilidad, rendimiento y enlaces. Deja la evidencia anotada en cada tarea.',
    me: 'Reviso el resultado. Las fuentes y las cifras las valido yo: si algo no está respaldado, no se publica.',
  },
  {
    title: 'Publicación',
    ai: 'Me pregunta si publico. La pregunta y mi respuesta literal quedan registradas en el repositorio.',
    me: 'Doy o niego el consentimiento. La integración final en la rama principal la hago siempre yo.',
  },
];


// Caso de uso: cómo nace un artículo del blog con OpenSpec
const articleSteps = [
  {
    icon: 'debate',
    title: 'Idea y debate',
    tool: 'skill blog-post',
    ai: 'Me entrevista: qué tipo de post es (Opinión, Análisis, Guía o Recursos), reta la tesis con el mejor contraargumento y verifica cada dato antes de aceptarlo. No escribe nada.',
    me: 'Aporto la idea y elijo el tipo y el ángulo.',
    output: 'Tesis, evidencia y estructura acordadas',
  },
  {
    icon: 'plan',
    title: 'Propuesta',
    tool: '/opsx:propose',
    ai: 'Convierte lo debatido en un change: la propuesta, el diseño con la tesis y la estructura, y las tareas de redacción y verificación.',
    me: 'Reviso el alcance antes de escribir una sola línea.',
    output: 'Un change de OpenSpec para el artículo',
  },
  {
    icon: 'write',
    title: 'Redacción y verificación',
    tool: '/opsx:apply',
    ai: 'Escribe el artículo, contrasta cada afirmación con su fuente, prueba los comandos de las guías en una máquina real y anota la evidencia en cada tarea.',
    me: 'Leo y pido ajustes de tono, estructura o recortes hasta que el texto dice lo que quiero decir.',
    output: 'El artículo terminado y verificado',
  },
  {
    icon: 'publish',
    title: 'Publicación',
    tool: '/opsx:archive',
    ai: 'Me pregunta si publico y registra la pregunta y mi respuesta literal. Sin consentimiento, el artículo se queda en borrador.',
    me: 'Doy o niego el consentimiento y hago el merge.',
    output: 'El artículo publicado en el blog',
  },
];

const articleRules = [
  { icon: 'source', text: 'Ningún dato, cita ni cifra sin una fuente comprobable.' },
  { icon: 'debate', text: 'La tesis se reta con su mejor contraargumento antes de escribirse.' },
  { icon: 'lock', text: 'Sin mi consentimiento explícito, no se publica.' },
];

// Iconos de trazo (24x24), decorativos
const icons: Record<string, string> = {
  debate: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M8 9h8 M8 13h5',
  plan: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h6',
  write: 'M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z',
  publish: 'M22 2 11 13 M22 2l-7 20-4-9-9-4z',
  source: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z M9 7h7 M9 11h5',
  lock: 'M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4',
};
---

<Layout
  title="Cómo se hace este sitio · Pablo Melero Alonso"
  description="Cómo se genera el contenido de este sitio: con IA, en un flujo de debate y acuerdo con el autor, y sin publicar nada sin su consentimiento."
>
  <Header />
  <main class="how">
    <section class="how-hero">
      <div class="container">
        <span class="section-label">Transparencia</span>
        <h1 class="how-title">Cómo se hace este sitio</h1>
        <p class="how-lead">
          Todo lo que ves aquí, los textos, el código y esta misma página, se crea con ayuda de IA.
          Pero la IA no decide sola: cada cambio nace de un debate conmigo y nada se publica sin mi
          consentimiento explícito.
        </p>
        <p class="how-text">
          "Revisado y validado por mí" significa exactamente eso: lo reviso yo. No hay revisión de
          terceros ni ningún sello externo, y puedo equivocarme.
        </p>
      </div>
    </section>

    <section class="how-section" aria-labelledby="how-arch">
      <div class="container">
        <div class="how-narrow">
          <h2 id="how-arch" class="how-heading">La solución, de un vistazo</h2>
          <p class="how-text">
            Quién interviene y cómo llega el contenido desde el debate hasta tu navegador.
          </p>
        </div>

        <figure class="arch">
          <!-- Variante horizontal (>= 1024px) -->
          <svg class="arch-svg arch-svg--wide" viewBox="29 0 933 530" role="img" aria-labelledby="arch-wide-title arch-wide-desc">
            <title id="arch-wide-title">Esquema de arquitectura de este sitio</title>
            <desc id="arch-wide-desc">El autor debate con los agentes de IA (Claude Code y Codex) y toma las decisiones. Los agentes generan en el repositorio público de GitHub los artefactos de OpenSpec (openspec/: propuesta, diseño, especificaciones y tareas, con la evidencia y los consentimientos) y el código y los textos del sitio (src/: Astro y MDX). El autor revisa, aprueba e integra: cada cambio va en una rama feat/*, pasa por una pull request y el autor hace el merge a main. El push a main lanza el build en GitHub Actions, que despliega en GitHub Pages el HTML estático que recibe el visitante en pablomeleroalonso.me. OpenSpec ordena el trabajo en cuatro fases: debate, acuerdo, construcción y publicación.</desc>
            <defs>
              <marker id="arch-wide-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" class="arch-head" />
              </marker>
              <marker id="arch-wide-arrow-me" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" class="arch-head arch-head--me" />
              </marker>
            </defs>

            <!-- Autor y agentes -->
            <rect x="30" y="30" width="220" height="100" rx="12" class="arch-box arch-box--me" />
            <text x="140" y="72" class="arch-name arch-name--me" text-anchor="middle">AUTOR</text>
            <text x="140" y="98" class="arch-note" text-anchor="middle">decide y valida</text>

            <rect x="390" y="30" width="250" height="100" rx="12" class="arch-box arch-box--ai" />
            <text x="515" y="72" class="arch-name arch-name--ai" text-anchor="middle">AGENTES DE IA</text>
            <text x="515" y="98" class="arch-note" text-anchor="middle">Claude Code · Codex</text>

            <line x1="254" y1="80" x2="386" y2="80" class="arch-line" marker-start="url(#arch-wide-arrow)" marker-end="url(#arch-wide-arrow)" />
            <text x="320" y="68" class="arch-label" text-anchor="middle">debate</text>
            <text x="320" y="102" class="arch-label" text-anchor="middle">decisiones</text>

            <!-- Relaciones con el repositorio -->
            <line x1="140" y1="130" x2="140" y2="206" class="arch-line arch-line--me" marker-end="url(#arch-wide-arrow-me)" />
            <text x="152" y="165" class="arch-label">revisa, aprueba</text>
            <text x="152" y="183" class="arch-label">y hace merge</text>

            <line x1="515" y1="130" x2="515" y2="206" class="arch-line" marker-end="url(#arch-wide-arrow)" />
            <text x="527" y="165" class="arch-label">genera artefactos,</text>
            <text x="527" y="183" class="arch-label">código y texto</text>

            <!-- Repositorio -->
            <rect x="30" y="210" width="610" height="190" rx="12" class="arch-box" />
            <text x="50" y="240" class="arch-name">REPOSITORIO GITHUB (PÚBLICO)</text>
            <rect x="50" y="256" width="280" height="96" rx="8" class="arch-sub" />
            <text x="66" y="284" class="arch-mono">openspec/</text>
            <text x="66" y="308" class="arch-note">proposal · design · specs · tasks</text>
            <text x="66" y="330" class="arch-note">evidencia y consentimientos</text>
            <rect x="344" y="256" width="276" height="96" rx="8" class="arch-sub" />
            <text x="360" y="284" class="arch-mono">src/</text>
            <text x="360" y="308" class="arch-note">Astro + MDX</text>
            <text x="360" y="330" class="arch-note">páginas y posts</text>
            <text x="335" y="382" class="arch-label" text-anchor="middle">rama feat/*  →  pull request  →  main</text>

            <!-- Entrega -->
            <line x1="640" y1="250" x2="716" y2="250" class="arch-line" marker-end="url(#arch-wide-arrow)" />
            <text x="678" y="238" class="arch-label" text-anchor="middle">push</text>
            <text x="678" y="272" class="arch-label" text-anchor="middle">a main</text>

            <rect x="720" y="210" width="240" height="80" rx="12" class="arch-box" />
            <text x="840" y="244" class="arch-name" text-anchor="middle">GITHUB ACTIONS</text>
            <text x="840" y="268" class="arch-note" text-anchor="middle">build de Astro</text>

            <line x1="840" y1="290" x2="840" y2="326" class="arch-line" marker-end="url(#arch-wide-arrow)" />

            <rect x="720" y="330" width="240" height="80" rx="12" class="arch-box" />
            <text x="840" y="364" class="arch-name" text-anchor="middle">GITHUB PAGES</text>
            <text x="840" y="388" class="arch-note" text-anchor="middle">HTML estático</text>

            <line x1="840" y1="410" x2="840" y2="446" class="arch-line" marker-end="url(#arch-wide-arrow)" />

            <rect x="720" y="450" width="240" height="70" rx="12" class="arch-box arch-box--visitor" />
            <text x="840" y="480" class="arch-name" text-anchor="middle">VISITANTE</text>
            <text x="840" y="503" class="arch-note" text-anchor="middle">pablomeleroalonso.me</text>

            <!-- OpenSpec -->
            <rect x="30" y="430" width="610" height="90" rx="12" class="arch-frame" />
            <text x="50" y="462" class="arch-name arch-name--ai">OPENSPEC ordena el trabajo</text>
            <text x="50" y="494" class="arch-note">01 debate  →  02 acuerdo  →  03 construcción  →  04 publicación</text>
          </svg>

          <!-- Variante vertical (< 1024px) -->
          <svg class="arch-svg arch-svg--narrow" viewBox="4 0 346 874" role="img" aria-labelledby="arch-narrow-title arch-narrow-desc">
            <title id="arch-narrow-title">Esquema de arquitectura de este sitio</title>
            <desc id="arch-narrow-desc">El autor debate con los agentes de IA (Claude Code y Codex) y toma las decisiones. Los agentes generan en el repositorio público de GitHub los artefactos de OpenSpec (openspec/: propuesta, diseño, especificaciones y tareas, con la evidencia y los consentimientos) y el código y los textos del sitio (src/: Astro y MDX). El autor revisa, aprueba e integra: cada cambio va en una rama feat/*, pasa por una pull request y el autor hace el merge a main. El push a main lanza el build en GitHub Actions, que despliega en GitHub Pages el HTML estático que recibe el visitante en pablomeleroalonso.me. OpenSpec ordena el trabajo en cuatro fases: debate, acuerdo, construcción y publicación.</desc>
            <defs>
              <marker id="arch-narrow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" class="arch-head" />
              </marker>
              <marker id="arch-narrow-arrow-me" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" class="arch-head arch-head--me" />
              </marker>
            </defs>

            <rect x="44" y="10" width="304" height="64" rx="12" class="arch-box arch-box--me" />
            <text x="196" y="38" class="arch-name arch-name--me" text-anchor="middle">AUTOR</text>
            <text x="196" y="60" class="arch-note" text-anchor="middle">decide y valida</text>

            <line x1="196" y1="78" x2="196" y2="120" class="arch-line" marker-start="url(#arch-narrow-arrow)" marker-end="url(#arch-narrow-arrow)" />
            <text x="208" y="104" class="arch-label">debate · decisiones</text>

            <rect x="44" y="124" width="304" height="64" rx="12" class="arch-box arch-box--ai" />
            <text x="196" y="152" class="arch-name arch-name--ai" text-anchor="middle">AGENTES DE IA</text>
            <text x="196" y="174" class="arch-note" text-anchor="middle">Claude Code · Codex</text>

            <line x1="196" y1="188" x2="196" y2="234" class="arch-line" marker-end="url(#arch-narrow-arrow)" />
            <text x="208" y="208" class="arch-label">genera artefactos,</text>
            <text x="208" y="226" class="arch-label">código y texto</text>

            <!-- Autor -> repositorio, por el lateral -->
            <polyline points="44,42 22,42 22,420 40,420" class="arch-line arch-line--me" marker-end="url(#arch-narrow-arrow-me)" />
            <text x="14" y="300" class="arch-label" text-anchor="middle" transform="rotate(-90 14 300)">revisa, aprueba y hace merge</text>

            <rect x="44" y="238" width="304" height="204" rx="12" class="arch-box" />
            <text x="60" y="262" class="arch-name">REPOSITORIO GITHUB</text>
            <rect x="60" y="274" width="272" height="66" rx="8" class="arch-sub" />
            <text x="74" y="298" class="arch-mono">openspec/</text>
            <text x="74" y="322" class="arch-note">proposal · design · specs · tasks</text>
            <rect x="60" y="350" width="272" height="56" rx="8" class="arch-sub" />
            <text x="74" y="374" class="arch-mono">src/</text>
            <text x="74" y="396" class="arch-note">Astro + MDX</text>
            <text x="196" y="428" class="arch-label" text-anchor="middle">feat/* → pull request → main</text>

            <line x1="196" y1="442" x2="196" y2="490" class="arch-line" marker-end="url(#arch-narrow-arrow)" />
            <text x="208" y="470" class="arch-label">push a main</text>

            <rect x="44" y="494" width="304" height="60" rx="12" class="arch-box" />
            <text x="196" y="520" class="arch-name" text-anchor="middle">GITHUB ACTIONS</text>
            <text x="196" y="542" class="arch-note" text-anchor="middle">build de Astro</text>

            <line x1="196" y1="554" x2="196" y2="590" class="arch-line" marker-end="url(#arch-narrow-arrow)" />

            <rect x="44" y="594" width="304" height="60" rx="12" class="arch-box" />
            <text x="196" y="620" class="arch-name" text-anchor="middle">GITHUB PAGES</text>
            <text x="196" y="642" class="arch-note" text-anchor="middle">HTML estático</text>

            <line x1="196" y1="654" x2="196" y2="690" class="arch-line" marker-end="url(#arch-narrow-arrow)" />

            <rect x="44" y="694" width="304" height="60" rx="12" class="arch-box arch-box--visitor" />
            <text x="196" y="720" class="arch-name" text-anchor="middle">VISITANTE</text>
            <text x="196" y="742" class="arch-note" text-anchor="middle">pablomeleroalonso.me</text>

            <rect x="44" y="776" width="304" height="94" rx="12" class="arch-frame" />
            <text x="60" y="804" class="arch-name arch-name--ai">OPENSPEC ordena el trabajo</text>
            <text x="60" y="830" class="arch-note">01 debate → 02 acuerdo</text>
            <text x="60" y="852" class="arch-note">03 construcción → 04 publicación</text>
          </svg>

        </figure>
      </div>
    </section>

    <section class="how-section" aria-labelledby="how-flow">
      <div class="container">
        <div class="how-narrow">
          <h2 id="how-flow" class="how-heading">El flujo, en cuatro fases</h2>
          <p class="how-text">
            En cada fase la IA propone y yo decido. Nada pasa a la siguiente sin mi visto bueno.
          </p>
          <p class="how-legend" aria-hidden="true">
            <span class="how-legend-item how-legend-item--ai">La IA propone</span>
            <span class="how-legend-item how-legend-item--me">Yo decido</span>
          </p>
        </div>
        <ol class="how-flow">
          {phases.map((phase, i) => (
            <li class="how-phase">
              <h3 class="how-phase-title">
                <span class="how-phase-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {phase.title}
              </h3>
              <div class="how-lane how-lane--ai">
                <p class="how-lane-who">La IA</p>
                <p class="how-lane-text">{phase.ai}</p>
              </div>
              <span class="how-sync" aria-hidden="true">⇅</span>
              <div class="how-lane how-lane--me">
                <p class="how-lane-who">Yo</p>
                <p class="how-lane-text">{phase.me}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="how-section" aria-labelledby="how-article">
      <div class="container">
        <div class="how-narrow">
          <span class="section-label">Caso de uso</span>
          <h2 id="how-article" class="how-heading">Cómo nace un artículo del blog</h2>
          <p class="how-text">
            Lo anterior aplica a todo el sitio. Los artículos siguen el mismo flujo de OpenSpec, con una
            fase previa de debate editorial y reglas propias para lo que se publica.
          </p>
        </div>

        <ol class="info-steps">
          {articleSteps.map((step, i) => (
            <li class="info-step">
              <div class="info-node" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={icons[step.icon]} />
                </svg>
              </div>
              <div class="info-body">
                <p class="info-kicker">
                  <span class="info-number">{String(i + 1).padStart(2, '0')}</span>
                  <code class="info-tool">{step.tool}</code>
                </p>
                <h3 class="info-title">{step.title}</h3>
                <p class="info-role info-role--ai"><strong>La IA</strong> {step.ai}</p>
                <p class="info-role info-role--me"><strong>Yo</strong> {step.me}</p>
                <p class="info-output"><span class="info-output-label">Sale</span> {step.output}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="info-rules">
          <h3 class="info-rules-title">Reglas que se aplican a todos los artículos</h3>
          <ul class="info-rules-list">
            {articleRules.map((rule) => (
              <li class="info-rule">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={icons[rule.icon]} />
                </svg>
                <span>{rule.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="how-section how-closing">
      <div class="container">
        <p class="how-text">
          ¿Has encontrado un error? <a href={`${import.meta.env.BASE_URL}contacto`}>Escríbeme</a> y lo corrijo.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Ancho de lectura para los párrafos; las secciones usan el ancho del .container como el resto del sitio */
  .how-narrow,
  .how-lead,
  .how-text {
    max-width: 760px;
  }

  .how-hero {
    padding: calc(var(--header-height) + 5rem) 0 2rem;
  }

  .how-title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-top: 0.5rem;
  }

  .how-lead {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .how-text {
    margin-top: 0.75rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .how-text a {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .how-section {
    padding: 2.5rem 0;
  }

  .how-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* ── Esquema de arquitectura (SVG inline) ── */
  .arch {
    margin: 2rem 0 0;
  }

  .arch-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .arch-svg--wide {
    display: none;
  }

  .arch-svg--narrow {
    max-width: 420px;
    margin: 0 auto;
  }

  .arch-box {
    fill: var(--color-bg-2);
    stroke: var(--color-border-2);
    stroke-width: 1.5;
  }

  .arch-box--me {
    stroke: var(--color-logo-yellow);
    stroke-width: 2;
  }

  .arch-box--ai {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .arch-box--visitor {
    stroke: var(--color-text);
  }

  .arch-sub {
    fill: var(--color-surface-2);
    stroke: var(--color-border);
  }

  .arch-frame {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .arch-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .arch-line--me {
    stroke: var(--color-logo-yellow);
  }

  .arch-head {
    fill: var(--color-accent);
  }

  .arch-head--me {
    fill: var(--color-logo-yellow);
  }

  .arch-name {
    fill: var(--color-text);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .arch-name--me { fill: var(--color-logo-yellow); }
  .arch-name--ai { fill: var(--color-accent-light); }

  .arch-mono {
    fill: var(--color-accent-light);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
  }

  .arch-note {
    fill: var(--color-text);
