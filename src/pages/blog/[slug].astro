---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { sections } from '../../data/sections';
import { readingTime } from '../../utils/readingTime';
import { author } from '../../data/author';

export async function getStaticPaths() {
  if (!sections.blog) return [];
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const categoryColors: Record<string, string> = {
  'Arquitectura':   '#00BDD4',
  'DevOps':         '#5CB845',
  'IA Generativa':  '#A78BFA',
  'Liderazgo':      '#F5C200',
  'Opinión':        '#F6AD55',
};
const categoryColor = categoryColors[post.data.category] ?? '#00BDD4';

// Mismo formato de fecha que BlogCard, para que la cabecera del artículo y
// las tarjetas (listado, portada, relacionados) muestren la fecha igual.
const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const formattedDate = dateFormatter.format(post.data.publishDate);
const formattedUpdatedDate = post.data.updatedDate ? dateFormatter.format(post.data.updatedDate) : undefined;
const readingTimeMinutes = readingTime(post.body);

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.data.category, href: `/blog?category=${encodeURIComponent(post.data.category)}` },
];

const ctaText = post.data.ctaText ?? '¿Te resultó útil? Me interesa saber qué piensas.';
const ctaLabel = post.data.ctaLabel ?? 'Hablemos';
const ctaHref = post.data.ctaHref ?? '/contacto';

const publishedTimeISO = post.data.publishDate.toISOString();
const modifiedTimeISO = post.data.updatedDate?.toISOString();

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pablomeleroalonso.me';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = post.data.image ? new URL(post.data.image, siteUrl).toString() : undefined;

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  ...(imageUrl && { image: imageUrl }),
  datePublished: publishedTimeISO,
  ...(modifiedTimeISO && { dateModified: modifiedTimeISO }),
  ...(author && { author: { '@type': 'Person', name: author.name } }),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href && { item: new URL(item.href, siteUrl).toString() }),
  })),
};
---

<Layout
  title={`${post.data.title} · Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={publishedTimeISO}
  modifiedTime={modifiedTimeISO}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogPostingJsonLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <Header />
  <main>
    <!-- Article Header -->
    <header class="article-header">
      <div class="container article-header-inner">
        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
          <ol>
            {breadcrumbItems.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ol>
        </nav>

        <div class="article-taxonomy reveal reveal-delay-1">
          <span class="article-category" style={`color: ${categoryColor}; border-color: ${categoryColor}33;`}>
            {post.data.category}
          </span>
          <div class="article-meta-group">
            <time class="article-date" datetime={publishedTimeISO}>
              <span aria-hidden="true">📅</span> {formattedDate}
            </time>
            {readingTimeMinutes !== undefined && (
              <span class="article-reading-time">
                <span aria-hidden="true">⏱️</span> {readingTimeMinutes} min
              </span>
            )}
            {formattedUpdatedDate && (
              <span class="article-updated">
                Actualizado el <time datetime={modifiedTimeISO}>{formattedUpdatedDate}</time>
              </span>
            )}
          </div>
        </div>

        <h1 class="article-title reveal reveal-delay-2">{post.data.title}</h1>
        <p class="article-description reveal reveal-delay-3">{post.data.description}</p>

        {post.data.tags.length > 0 && (
          <div class="article-tags reveal reveal-delay-4">
            {post.data.tags.map((tag) => (
              <a class="article-tag" href={`/blog?tags=${encodeURIComponent(tag)}`}>#{tag}</a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Featured image -->
    {post.data.image && (
      <div class="article-image-wrap">
        <div class="container">
          <img src={post.data.image} alt={post.data.title} class="article-image" loading="eager" />
        </div>
      </div>
    )}

    <!-- Article Content -->
    <article class="article-body">
      <div class="container article-content">
        <Content />
      </div>
    </article>

    <!-- Author bio -->
    {author && (
      <section class="author-section">
        <div class="container">
          <div class="author-card reveal">
            <img src={author.avatar} alt={author.name} class="author-avatar" onerror="this.style.display='none'" />
            <div class="author-info">
              <p class="author-name">{author.name}</p>
              <p class="author-bio">{author.bio}</p>
              <div class="author-links">
                {author.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener" class="author-link">{link.label}</a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Related posts -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <h2 class="related-title reveal">Artículos relacionados</h2>
          <div class="related-grid">
            {related.map((p) => (
              <BlogCard
                title={p.data.title}
                description={p.data.description}
                publishDate={p.data.publishDate}
                category={p.data.category}
                tags={p.data.tags}
                slug={p.id}
                image={p.data.image}
                readingTimeMinutes={readingTime(p.body)}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="article-cta">
      <div class="container">
        <div class="article-cta-inner reveal">
          <p class="article-cta-text">{ctaText}</p>
          <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .article-header {
    padding: calc(var(--header-height) + 4rem) 0 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-header-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb li + li::before {
    content: '/';
    color: var(--color-text-subtle);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: color var(--ease);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Category + metadata (misma fila, alineadas a extremos opuestos, como BlogCard) ── */
  .article-taxonomy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .article-category {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border: 1px solid;
    border-radius: var(--r-full);
  }

  .article-meta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .article-date {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .article-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .article-updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── Tags (debajo de la bajada) ── */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    padding: 0.3rem 0.75rem;
    transition: color var(--ease), border-color var(--ease), background var(--ease);
  }

  .article-tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .article-tag:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  /* ── Featured image ── */
  .article-image-wrap {
    padding: 3rem 0 0;
  }

  .article-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-lg);
    border: 1px solid var(--color-border);
    display: block;
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Prose styles ── */
  .article-body {
    padding: 4rem 0;
  }

  .article-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .article-content :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .article-content :global(p) {
    margin-bottom: 1.4rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.4rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: var(--r-sm);
  }

  .article-content :global(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.75rem 1.25rem;
    margin: 2rem 0;
    background: var(--color-surface);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-surface-2);
    padding: 0.15em 0.4em;
    border-radius: var(--r-sm);
    color: var(--color-accent-light);
  }

  .article-content :global(pre) {
    background: #0d1117;
    border: 1px solid var(--color-border);
    border-radius: var(--r-md);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: #e6edf3;
    font-size: 0.9rem;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .article-content :global(img) {
    border-radius: var(--r-md);
    margin: 2rem auto;
  }

  /* ── Author ── */
  .author-section {
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .author-card {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .author-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--color-border-2);
  }

  .author-name {
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .author-bio {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .author-links {
    display: flex;
    gap: 1rem;
  }

  .author-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    border-radius: var(--r-sm);
    transition: opacity var(--ease);
  }

  .author-link:hover {
    opacity: 0.7;
  }

  .author-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Related ── */
  .related-section {
    padding: 4rem 0;
  }

  .related-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* ── CTA ── */
  .article-cta {
    padding: 5rem 0;
  }

  .article-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .article-cta-text {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 2rem;
    background: var(--color-accent);
    color: #000;
    font-weight: 700;
    border-radius: var(--r-full);
    transition: opacity var(--ease), transform var(--ease);
  }

  .btn-primary:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
