---
import { categoryColors, type BlogCategory } from '../data/blogCategories';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: BlogCategory;
  tags: string[];
  slug: string;
  featured?: boolean;
  image?: string;
  readingTimeMinutes?: number;
}

const {
  title,
  description,
  publishDate,
  category,
  slug,
  featured = false,
  image,
  readingTimeMinutes,
} = Astro.props;

const color = categoryColors[category];

const formattedDate = publishDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const isoDate = publishDate.toISOString();
---

<article
  class={`blog-card-item ${featured ? 'blog-card-item--featured' : ''}`}
  data-category={category}
>
  <a href={`/blog/${slug}`} class="blog-card" aria-label={title}>
    <div class={`blog-card-media ${image ? '' : 'blog-card-media--placeholder'}`}>
      {image ? (
        <img src={image} alt={title} class="blog-card-image" loading="lazy" />
      ) : (
        <img
          src={`${import.meta.env.BASE_URL}logo.png`}
          alt=""
          class="blog-card-media-logo"
          loading="lazy"
        />
      )}
    </div>
    <div class="blog-card-inner">
      <div class="blog-card-header-row">
        <span class="blog-card-category" style={`color: ${color}; border-color: color-mix(in srgb, ${color} 20%, transparent);`}>{category}</span>
        <div class="blog-card-header-meta">
          <time class="blog-card-date" datetime={isoDate}>
            <span aria-hidden="true">📅</span> {formattedDate}
          </time>
          {readingTimeMinutes !== undefined && (
            <span class="blog-card-reading-badge">
              <span aria-hidden="true">⏱️</span> {readingTimeMinutes} min
            </span>
          )}
        </div>
      </div>
      <h3 class="blog-card-title">{title}</h3>
      <p class="blog-card-description">{description}</p>
      <span class="blog-card-cta">
        Leer artículo
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
    <div class="blog-card-accent" style={`background: ${color};`}></div>
  </a>
</article>

<style>
  .blog-card-item {
    position: relative;
  }

  .blog-card-item--featured {
    grid-column: 1 / -1;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
  }

  .blog-card:hover {
    border-color: var(--color-border-2);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 189, 212, 0.08);
  }

  .blog-card:focus {
    outline: none;
  }

  .blog-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .blog-card-item--featured .blog-card-title {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
  }

  .blog-card-item--featured .blog-card-description {
    font-size: 0.9rem;
    -webkit-line-clamp: 3;
  }

  @media (min-width: 769px) {
    .blog-card-item--featured .blog-card {
      flex-direction: row;
    }

    .blog-card-item--featured .blog-card-media {
      flex: 0 0 42%;
      aspect-ratio: auto;
      height: auto;
      max-height: none;
      min-height: 260px;
    }

    .blog-card-item--featured .blog-card-inner {
      flex: 1;
    }
  }

  .blog-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 190px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--ease);
  }

  .blog-card:hover .blog-card-image {
    transform: scale(1.04);
  }

  .blog-card-media--placeholder {
    background-color: var(--color-bg-2);
    background-image:
      radial-gradient(ellipse 80% 70% at 50% -10%, rgba(0, 189, 212, 0.14), transparent),
      radial-gradient(ellipse 40% 40% at 85% 80%, rgba(0, 153, 200, 0.08), transparent),
      radial-gradient(ellipse 30% 30% at 10% 70%, rgba(213, 66, 96, 0.05), transparent);
  }

  .blog-card-media-logo {
    height: 34px;
    width: auto;
    opacity: 0.55;
  }

  .blog-card-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .blog-card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-card-header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-card-category {
    display: inline-block;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border: 1px solid;
    border-radius: var(--r-full);
  }

  .blog-card-date {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .blog-card-reading-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  .blog-card-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--ease);
  }

  .blog-card:hover .blog-card-title {
    color: var(--color-accent-light);
  }

  .blog-card-description {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .blog-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 0.1rem;
    transition: gap var(--ease);
  }

  .blog-card:hover .blog-card-cta {
    gap: 0.6rem;
  }

  .blog-card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    opacity: 0;
    transition: opacity var(--ease);
  }

  .blog-card:hover .blog-card-accent {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card-image,
    .blog-card-title,
    .blog-card-cta,
    .blog-card-accent {
      transition: none;
    }

    .blog-card:hover {
      transform: none;
    }

    .blog-card:hover .blog-card-image {
      transform: none;
    }
  }
</style>
